# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# PostgreSQL Connection String (Use pure-Python pg8000 driver for cross-platform reliability)
DATABASE_URL=postgresql+pg8000://postgres:YOUR_DB_PASSWORD@db.your-project-id.supabase.co:5432/postgres

# Allowed CORS Origins (comma-separated for dev and production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Razorpay TEST credentials. Keep these in backend/.env only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_API_URL=https://api.razorpay.com/v1
BOOKING_HOLD_SECONDS=300
PAYMENT_HOLD_SECONDS=900
